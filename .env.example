# CurseForge API key (https://console.curseforge.com). Required to enable the
# Advanced Editor's Mods tab; read server-side only and never sent to the
# browser. When unset, /api/curseforge/* routes return 503. Keys contain `$`
# characters, which Next.js treats as variable references: escape each one
# as `\$` (e.g. CURSEFORGE_API_KEY=\$2a\$10\$...).
CURSEFORGE_API_KEY=

# Maximum mod jar size, in bytes, that the download proxy will stream.
# Defaults to 104857600 (100 MiB).
CURSEFORGE_MAX_JAR_BYTES=104857600

# MCP server output files (/api/mcp) go to a private Vercel Blob store and are
# returned as signed URLs that expire after 24 hours. Connecting the store to
# the Vercel project adds BLOB_STORE_ID; on Vercel the SDK authenticates with
# the deployment's OIDC token (VERCEL_OIDC_TOKEN), so no token is set by hand.
# For local development run `vercel env pull .env.local`, which writes
# BLOB_STORE_ID and a short-lived VERCEL_OIDC_TOKEN (pull again when it
# expires). Without credentials, MCP tools that write files return an error.
BLOB_STORE_ID=

# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to
# /api/cron/mcp-blob-cleanup, which deletes MCP output files older than 24
# hours. Requests without it are rejected with 401. Use a random string of at
# least 16 characters.
CRON_SECRET=
