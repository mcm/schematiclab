{
  "name": "schematiclab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:translations": "node --experimental-strip-types scripts/generate-block-translations.mts && node --experimental-strip-types scripts/generate-forge-1.12-flatten.mts",
    "gen:mc-assets": "node --experimental-strip-types scripts/build-minecraft-assets.mts",
    "gen:camo-shapes": "node --experimental-strip-types scripts/generate-camo-shapes.mts",
    "gen:camo-fixture-datapacks": "node --experimental-strip-types scripts/generate-camo-fixture-datapacks.mts",
    "gen:camo-block-states": "node --experimental-strip-types scripts/generate-camo-block-states.mts",
    "gen:ucw-fixture-functions": "node --experimental-strip-types scripts/generate-ucw-fixture-functions.mts",
    "modpack:upload": "node --experimental-strip-types scripts/upload-modpack.mts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@iamthemcmaster/ui": "^1.1.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@napi-rs/canvas": "^1.0.10",
    "@tabler/icons-react": "^3.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "deepslate": "^0.26.0",
    "fflate": "^0.8.3",
    "gl-matrix": "^3.4.4",
    "idb": "^8.0.3",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.1",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.1.3"
}
